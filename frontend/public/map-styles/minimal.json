{
  "version": 8,
  "name": "Civil Atlas historical atlas",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "land-background": {
      "type": "geojson",
      "data": {
        "type": "Feature",
        "properties": {},
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -180,
                -85
              ],
              [
                180,
                -85
              ],
              [
                180,
                85
              ],
              [
                -180,
                85
              ],
              [
                -180,
                -85
              ]
            ]
          ]
        }
      }
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "\u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#06101a"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "land-background",
      "paint": {
        "fill-color": "#d8d8ce"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9c3ce"
      }
    },
    {
      "id": "modern-locality-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          10,
          12,
          13
        ],
        "text-padding": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#475b61",
        "text-halo-color": "#f3f2e8",
        "text-halo-width": 1.2,
        "text-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0,
          7,
          0.65,
          10,
          0.85
        ]
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town"
          ]
        ]
      ]
    }
  ]
}

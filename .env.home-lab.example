# Template only: put real values in the host secret store, outside Git.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://civil_atlas:replace-password@postgres.internal:5432/civil_atlas
CORS_ORIGINS=https://civil-atlas.example
EDITORIAL_API_KEY=replace-with-a-random-editorial-key
# Enable only behind private HTTPS ingress; see docs/editor-review.md.
EDITOR_UI_ENABLED=false
S3_ENDPOINT=https://objects.internal
S3_ACCESS_KEY_ID=replace-with-a-scoped-storage-key
S3_SECRET_ACCESS_KEY=replace-with-a-storage-secret
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
